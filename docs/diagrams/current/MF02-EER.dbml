// Application-only relationships. NOT SQL constraints. Parent existence is not guaranteed by this schema.
// L01 campaign_questionnaire_assignments.questionnaire_version_id -> questionnaire_version.id: Publication port checks that the selected version exists and is published. No SQL FK.
// L02 operational_staff_rosters.user_id -> user_accounts.id: Scalar authenticated staff identity; roster registration does not enforce an account FK or account existence.
// L03 operational_staff_identities.user_id -> user_accounts.id: Unique per-user locking anchor; scalar ID, no account existence constraint. At most one anchor per account.
// L04 session_staff_assignments.user_id -> user_accounts.id: Copied staff user identity, resolved against the authenticated principal. No SQL FK.
// L05 operational_staff_rosters.user_id -> operational_staff_identities.user_id: Registering or modifying a roster ensures and locks the unique user anchor. An application concurrency association, not a database FK.
// L06 session_staff_assignments.user_id -> operational_staff_identities.user_id: Assignment services ensure and lock the unique user anchor. Not a database FK.
// L07 session_change_events.old_center_id -> vaccination_centers.id: Embedded schedule snapshot copies a center ID. Historical snapshot, not a FK or a separate entity/table.
// L08 session_change_events.new_center_id -> vaccination_centers.id: Embedded schedule snapshot copies a center ID. Historical snapshot, not a FK or a separate entity/table.
// L09 campaign_lifecycle_events.actor_id -> user_accounts.id: Opaque VARCHAR(64) actor; authenticated user IDs are encoded as strings, but system/fallback actors also exist. Conditional account match only.
// L10 session_change_events.actor_id -> user_accounts.id: Opaque VARCHAR(64) actor; controllers encode the trusted principal ID. Service-level actor values are opaque and not account FK constraints.
// L11 session_capacity_plans.approved_by -> user_accounts.id: Nullable VARCHAR(64) approval identity derived from AuthenticatedActor.userId(). Encoded string, not a database FK.
// L12 screening_submission.campaign_id -> vaccination_campaigns.id: MF-01 scalar campaign identity; submission service uses CampaignScreeningReader and the effective questionnaire assignment.
// L13 eligibility_assessment.campaign_id -> vaccination_campaigns.id: MF-01 assessment retains scalar campaign ID associated with screening. No campaign FK.

TableGroup Campaign {
  vaccination_campaigns
  campaign_location_targets
  campaign_dose_programmes
  campaign_lifecycle_events
  campaign_center_assignments
  campaign_questionnaire_assignments
}

TableGroup Center {
  vaccination_centers
  operating_hours
  center_closures
  operational_resources
  operational_staff_rosters
  operational_staff_identities
}

TableGroup Session {
  vaccination_sessions
  session_recurrence_rules
  session_recurrence_rule_weekdays
  session_capacity_plans
  session_change_events
  session_resource_assignments
  session_staff_assignments
  time_slots
}

TableGroup Shared_reference {
  vaccine_types
  target_groups
}

TableGroup External_dependencies {
  user_accounts
  roles
  questionnaire
  questionnaire_version
  consent_notice_version
  screening_submission
  eligibility_assessment
  appointment
  citizen_campaign_booking_guard
  waitlist_entry
  vaccination_records
  manufacturers
  vaccine_batches
  center_inventories
  stock_transfers
  appointment_change_event
  waitlist_change_event
}
