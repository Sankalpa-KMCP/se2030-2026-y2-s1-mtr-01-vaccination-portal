# Backend Server & Database Environment Variables Template
SERVER_PORT=8080
# Reverse Proxy Forwarded Headers Strategy (default: none; set to 'framework' ONLY behind trusted reverse proxy)
SERVER_FORWARD_HEADERS_STRATEGY=none
DB_URL=jdbc:mysql://localhost:3306/vaccination_portal
DB_USERNAME=vaccination_app
DB_PASSWORD=replace_with_local_password
JPA_DDL_AUTO=none

# Project-Wide AI Assistant Configuration
# Keep disabled by default for safe local development and evaluation.
# API keys (OPENAI_API_KEY, GOOGLE_API_KEY) are strictly server-side and must never be exposed to the frontend or committed.
AI_ASSISTANT_ENABLED=false
# Supported providers: openai, ollama, gemini
AI_ASSISTANT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
GOOGLE_API_KEY=
GEMINI_API_KEY=
AI_ASSISTANT_TIMEOUT=15s
AI_ASSISTANT_MAX_INPUT_CHARACTERS=1500
AI_ASSISTANT_MAX_HISTORY_MESSAGES=10
AI_ASSISTANT_MAX_OUTPUT_TOKENS=500
AI_ASSISTANT_ANONYMOUS_RPM=5
AI_ASSISTANT_AUTHENTICATED_RPM=15
