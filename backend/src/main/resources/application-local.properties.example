# ============================================================
# Local Development Configuration Template
# ============================================================
#
# Copy this file to:
#
# application-local.properties
#
# The copied file is intentionally ignored by Git.
# Never commit real local credentials.
#
# LOCAL DEVELOPMENT ONLY.
#
# Usage:
# Run backend with the local profile:
#   PowerShell: .\mvnw.cmd spring-boot:run "-Dspring-boot.run.profiles=local"
#   Bash:       ./mvnw spring-boot:run -Dspring-boot.run.profiles=local
#
# The First Administrator Bootstrap automatically creates an initial
# local administrator account upon startup if no administrator exists yet.
# Note: It does not reset passwords for existing accounts.
# Change these values in your private application-local.properties if desired.
# ============================================================

# ------------------------------------------------------------
# Database
# ------------------------------------------------------------
spring.datasource.url=jdbc:mysql://localhost:3307/vaccination_portal
spring.datasource.username=root
spring.datasource.password=YOUR_LOCAL_MYSQL_PASSWORD

# ------------------------------------------------------------
# First Administrator Bootstrap (Local Development Only)
# ------------------------------------------------------------
app.bootstrap.admin.email=admin@local.test
app.bootstrap.admin.password=Admin123!
app.bootstrap.admin.full-name=Local Administrator
app.bootstrap.admin.phone=0771234567

# ------------------------------------------------------------
# Authentication Delivery Mode (smtp / console / disabled)
# ------------------------------------------------------------
# Explicit Console Delivery Mode (Recommended for local evaluation & manual testing)
# Outputs verification and password-reset links directly to backend console logs.
app.security.auth.delivery-mode=console

# Real SMTP Delivery Mode (Optional, uncomment and fill in for actual email dispatch)
# app.security.auth.delivery-mode=smtp
# app.security.auth.mail-from=noreply@example.com
# spring.mail.host=smtp.example.com
# spring.mail.port=587
# spring.mail.username=YOUR_SMTP_USERNAME
# spring.mail.password=YOUR_SMTP_PASSWORD
# spring.mail.properties.mail.smtp.auth=true
# spring.mail.properties.mail.smtp.starttls.enable=true

# ------------------------------------------------------------
# Project-Wide AI Assistant (Phase 1)
# ------------------------------------------------------------
# The AI assistant is disabled by default.
# The portal starts and operates normally when the AI assistant is unavailable or disabled.
# OPENAI_API_KEY belongs ONLY on the backend; NEVER place it in VITE_* variables,
# and NEVER commit a populated API key to version control.
# Standard unit and integration tests use a fake provider and never call OpenAI.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
AI_ASSISTANT_TIMEOUT=15s
AI_ASSISTANT_MAX_INPUT_CHARACTERS=1500
AI_ASSISTANT_MAX_HISTORY_MESSAGES=10
AI_ASSISTANT_MAX_OUTPUT_TOKENS=500
AI_ASSISTANT_ANONYMOUS_RPM=5
AI_ASSISTANT_AUTHENTICATED_RPM=15

